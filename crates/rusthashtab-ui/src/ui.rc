// Dialog templates for the rustHashTab property sheet page and settings dialog.
//
// Compiled by the Windows SDK's rc.exe from build.rs -- see the comment there
// for why this is not embed-resource.
//
// Deliberately does NOT #include <windows.h>. The templates need a handful of
// style bits and nothing else, and pulling in the SDK's headers would make this
// build depend on the resource compiler's include search path being arranged for
// it -- which `rc.exe` invoked from a build script does not get. The values
// below are from the Win32 window-style documentation and are ABI constants, not
// implementation details: they cannot change without breaking every compiled
// resource in existence.
//
//   WS_CHILD 0x40000000   WS_VISIBLE 0x10000000   WS_CLIPCHILDREN 0x02000000
//   WS_TABSTOP 0x00010000 WS_GROUP 0x00020000     WS_EX_CONTROLPARENT 0x00010000
//   WS_POPUP 0x80000000   WS_CAPTION 0x00C00000   WS_SYSMENU 0x00080000
//   WS_BORDER 0x00800000
//   DS_SETFONT 0x40       DS_FIXEDSYS 0x8         DS_CONTROL 0x400
//   DS_MODALFRAME 0x80    ES_AUTOHSCROLL 0x80     BS_PUSHBUTTON 0x0
//   LVS_REPORT 0x0001     LVS_SHOWSELALWAYS 0x0008   LVS_NOSORTHEADER 0x8000
//   LVS_NOCOLUMNHEADER 0x4000   LVS_SINGLESEL 0x0004
//   PBS_SMOOTH 0x01       SS_LEFT 0x0    SS_NOPREFIX 0x80

#define WS_CHILD            0x40000000L
#define WS_VISIBLE          0x10000000L
#define WS_CLIPCHILDREN     0x02000000L
#define WS_TABSTOP          0x00010000L
#define WS_GROUP            0x00020000L
#define WS_EX_CONTROLPARENT 0x00010000L
#define WS_POPUP            0x80000000L
#define WS_CAPTION          0x00C00000L
#define WS_SYSMENU          0x00080000L
#define WS_BORDER           0x00800000L

#define DS_SETFONT          0x00000040L
#define DS_FIXEDSYS         0x00000008L
#define DS_CONTROL          0x00000400L
#define DS_MODALFRAME       0x00000080L

#define ES_AUTOHSCROLL      0x00000080L

#define LVS_REPORT          0x00000001L
#define LVS_SINGLESEL       0x00000004L
#define LVS_SHOWSELALWAYS   0x00000008L
#define LVS_NOCOLUMNHEADER  0x00004000L
#define LVS_NOSORTHEADER    0x00008000L

#define PBS_SMOOTH          0x00000001L
#define SS_LEFT             0x00000000L
#define SS_NOPREFIX         0x00000080L
#define BS_PUSHBUTTON       0x00000000L

// Standard dialog command identifiers. `rc.exe` only knows these from
// `windows.h`, which this file deliberately does not include, so they are
// spelled out. Values are from `winuser.h` and are ABI constants.
#define IDOK                1
#define IDCANCEL            2

// Control identifiers. Keep in step with src/resource.rs -- a test parses this
// file and fails if the two lists disagree.
#define IDD_HASH_PROPPAGE   101

#define IDC_HASH_LIST       1001
#define IDC_HASH_STATUS     1002
#define IDC_HASH_PROGRESS   1003
#define IDC_HASH_COPY       1004
#define IDC_HASH_EXPECTED   1005
#define IDC_HASH_CHECK      1006
#define IDC_HASH_VERIFY     1007
#define IDC_HASH_EXPORT     1008
#define IDC_HASH_SETTINGS   1009

// The settings dialog. Checkboxes are read with IsDlgButtonChecked; the
// algorithm checklist is a report-mode list view switched to check boxes at
// runtime, so one control carries all 31 algorithms instead of 31 controls.
#define IDD_SETTINGS                        102

#define IDC_SETTINGS_ALGORITHMS             2101
#define IDC_SETTINGS_UPPERCASE              2102
#define IDC_SETTINGS_MONOSPACE              2103
#define IDC_SETTINGS_LOOK_FOR_SUMFILES      2104
#define IDC_SETTINGS_SUMFILE_UPPERCASE      2105
#define IDC_SETTINGS_SUMFILE_LF             2106
#define IDC_SETTINGS_SUMFILE_DOUBLE_SPACE   2107
#define IDC_SETTINGS_SUMFILE_FORWARD_SLASH  2108
#define IDC_SETTINGS_SUMFILE_CORZ           2109
#define IDC_SETTINGS_SUMFILE_BANNER         2110
#define IDC_SETTINGS_SUMFILE_BANNER_DATE    2111
#define IDC_SETTINGS_DEFAULTS               2112

IDD_HASH_PROPPAGE DIALOGEX 0, 0, 260, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Hashes"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_HASH_LIST, "SysListView32",
                    LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP,
                    7, 7, 246, 124

    LTEXT           "", IDC_HASH_STATUS, 7, 135, 246, 9,
                    SS_LEFT | SS_NOPREFIX | WS_GROUP

    LTEXT           "Expected:", -1, 7, 150, 42, 9, SS_LEFT | SS_NOPREFIX
    EDITTEXT        IDC_HASH_EXPECTED, 50, 148, 140, 13,
                    ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Check", IDC_HASH_CHECK, 196, 147, 57, 15,
                    BS_PUSHBUTTON | WS_TABSTOP

    PUSHBUTTON      "Ve&rify...", IDC_HASH_VERIFY, 7, 166, 58, 15,
                    BS_PUSHBUTTON | WS_TABSTOP
    PUSHBUTTON      "E&xport...", IDC_HASH_EXPORT, 68, 166, 58, 15,
                    BS_PUSHBUTTON | WS_TABSTOP
    PUSHBUTTON      "&Settings...", IDC_HASH_SETTINGS, 129, 166, 58, 15,
                    BS_PUSHBUTTON | WS_TABSTOP
    PUSHBUTTON      "&Copy", IDC_HASH_COPY, 200, 166, 53, 15,
                    BS_PUSHBUTTON | WS_TABSTOP

    CONTROL         "", IDC_HASH_PROGRESS, "msctls_progress32",
                    PBS_SMOOTH,
                    7, 186, 246, 10
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 258
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "rustHashTab Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Algorithms", -1, 7, 7, 286, 116
    CONTROL         "", IDC_SETTINGS_ALGORITHMS, "SysListView32",
                    LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    13, 19, 274, 98

    AUTOCHECKBOX    "Show digests in &uppercase", IDC_SETTINGS_UPPERCASE, 7, 129, 140, 10
    AUTOCHECKBOX    "Use a &monospace font", IDC_SETTINGS_MONOSPACE, 7, 142, 140, 10
    AUTOCHECKBOX    "&Look for checksum files next to the hashed files", IDC_SETTINGS_LOOK_FOR_SUMFILES, 7, 155, 274, 10

    GROUPBOX        "Exported checksum files", -1, 7, 169, 286, 57
    AUTOCHECKBOX    "&Uppercase hex", IDC_SETTINGS_SUMFILE_UPPERCASE, 13, 181, 90, 10
    AUTOCHECKBOX    "&LF line endings", IDC_SETTINGS_SUMFILE_LF, 13, 194, 90, 10
    AUTOCHECKBOX    "&Two spaces", IDC_SETTINGS_SUMFILE_DOUBLE_SPACE, 110, 181, 90, 10
    AUTOCHECKBOX    "&Forward slashes", IDC_SETTINGS_SUMFILE_FORWARD_SLASH, 110, 194, 90, 10
    AUTOCHECKBOX    "cor&z .hash lines", IDC_SETTINGS_SUMFILE_CORZ, 207, 181, 80, 10
    AUTOCHECKBOX    "&Banner", IDC_SETTINGS_SUMFILE_BANNER, 207, 194, 80, 10
    AUTOCHECKBOX    "Banner &date", IDC_SETTINGS_SUMFILE_BANNER_DATE, 110, 207, 90, 10

    PUSHBUTTON      "&Defaults", IDC_SETTINGS_DEFAULTS, 7, 236, 55, 15
    DEFPUSHBUTTON   "OK", IDOK, 190, 236, 48, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 236, 48, 15
END
